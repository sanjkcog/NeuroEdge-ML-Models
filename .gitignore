
# AgentForge local state and secrets
.claude/settings.local.json
.claude/.ts-edited-files
.claude/.source-edited-files
.claude/.ml-edited-files
.env
.env.*
!.env.example
agentic-assets/RELEASE_VERSION.json
agentic-assets/INSTALLED_MANIFEST.json

# ML dataset blobs — raw downloads never enter git (ml-artifact-destination: "No blobs")
neuroedge-ml-projects/*/data/raw/
# Derived per-trial features (sensor_align) — regenerable from data/raw/; alignment.json stays tracked
neuroedge-ml-projects/*/data/interim/*.parquet

# Python bytecode
__pycache__/
*.pyc
# Trainer upload package (dataset-verify step 6): regenerable from data/raw + data/interim
neuroedge-ml-projects/*/data/portal_upload.zip
# Training package (M8, ADR-0028 D-5): regenerable with `ml_contract.package build`; may hold the dataset
neuroedge-ml-projects/*/*/training-package.zip
# Contract dataset + simulator exports (ADR-0008): regenerable from data/raw + the lock; manifests stay tracked
neuroedge-ml-projects/*/data/contract/*.parquet
neuroedge-ml-projects/*/sim/*/
# Synthetic data blobs (M6 synth, signal mode): regenerable from data/synth/gen_synth.py + --seed;
# the generator script and synthetic-recipe.md stay tracked, manifest.json stays tracked
neuroedge-ml-projects/*/data/synthetic/*.parquet
